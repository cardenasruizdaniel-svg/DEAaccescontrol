# DLA Access Enterprise - Variables de Entorno
# Copie este archivo a backend/.env y configure

# Application
APP_NAME=DLA Access Enterprise
ENVIRONMENT=development
DEBUG=true

# Security (CAMBIAR EN PRODUCCIÓN)
SECRET_KEY=dla-local-dev-secret-key-change-in-production-2024
ENCRYPTION_KEY=dla-local-encryption-key-2024

# Database
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/dla_access_enterprise

# Redis (opcional)
REDIS_URL=redis://localhost:6379/0

# RabbitMQ (opcional)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Google Maps
GOOGLE_MAPS_API_KEY=

# AI
AI_API_KEY=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
